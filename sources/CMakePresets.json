{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN_RENDERER": "ON",
        "XRAY_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MinGW-w64 GCC + Ninja)",
      "inherits": "windows-x64-base",
      "binaryDir": "${sourceParentDir}/build/presets/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XRAY_BINARY_OUTPUT_DIRECTORY": "${sourceParentDir}/build/presets/windows-x64-debug/binaries"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MinGW-w64 GCC + Ninja)",
      "inherits": "windows-x64-base",
      "binaryDir": "${sourceParentDir}/build/presets/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XRAY_BINARY_OUTPUT_DIRECTORY": "${sourceParentDir}/build/presets/windows-x64-release/binaries"
      }
    },
    {
      "name": "linux-x64-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_VULKAN_RENDERER": "ON",
        "XRAY_HEADLESS_BUILD": "OFF",
        "XRAY_BUILD_EDITOR_HOST": "ON",
        "XRAY_COLLISION_USE_BULLET_BVH": "ON",
        "XRAY_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug (GCC + Ninja)",
      "inherits": "linux-x64-base",
      "binaryDir": "${sourceParentDir}/build/presets/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XRAY_BINARY_OUTPUT_DIRECTORY": "${sourceParentDir}/build/presets/linux-x64-debug/binaries"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release (GCC + Ninja)",
      "inherits": "linux-x64-base",
      "binaryDir": "${sourceParentDir}/build/presets/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XRAY_BINARY_OUTPUT_DIRECTORY": "${sourceParentDir}/build/presets/linux-x64-release/binaries"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Build All (Debug)",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Build All (Release)",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x64-cpu-tests-base",
      "hidden": true,
      "targets": [
        "xray_lua_sol_binding",
        "xray_windows_x64_contract",
        "xray_platform_x64_contract",
        "xray_vfs_legacy_decode",
        "xray_editor_host_abi_contract",
        "xray_avalonia_headless_tests",
        "xray_ogg_vorbis_contract",
        "xray_dependency_single_source_contract",
        "xray_math_and_binary_config_contract",
        "xray_callback_and_raii_contract",
        "xray_input_sdl3_contract",
        "xray_diagnostics_minidump_contract",
        "xray_diagnostics_pal3_contract",
        "xray_fs_vfs_pal2_contract",
        "xray_network_udp_loopback",
        "xray_physics_world_parity_contract",
        "xray_collision_bvh_parity_contract",
        "xray_physics_cook_fitter_contract",
        "xray_shader_compiler_pal5_contract",
        "xray_audio_backend_contract",
