<ResourceDictionary 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:item="clr-namespace:xray.editor.wpf_controls.property_editors.item"
	xmlns:property_grid="clr-namespace:xray.editor.wpf_controls.property_grid"
	xmlns:sdk="clr-namespace:xray.editor.wpf_controls">
    
	<Style TargetType="{x:Type item:named_item_editor}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type item:named_item_editor}">
					<Grid MinHeight="23" SnapsToDevicePixels="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName"/>
							<ColumnDefinition Width="5"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0" Padding="4,0,6,0"
						        MaxWidth="{Binding Path=(property_grid:property_grid_control.NameColumnLimit), RelativeSource={RelativeSource Self}}">
							<DockPanel>
								<Control DockPanel.Dock="Left" Width="{Binding item_indent, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"/>
								<TextBlock Text="{Binding name}" ToolTip="{Binding name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
							</DockPanel>
						</Border>
						<GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Focusable="False">
							<GridSplitter.Template>
								<ControlTemplate TargetType="GridSplitter">
									<Grid Background="Transparent">
										<Border x:Name="Divider" Width="1" HorizontalAlignment="Center" Background="{x:Static sdk:SdkWorkspaceTheme.Divider}"/>
									</Grid>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="Divider" Property="Width" Value="3"/>
											<Setter TargetName="Divider" Property="Background" Value="{x:Static sdk:SdkWorkspaceTheme.Accent}"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</GridSplitter.Template>
						</GridSplitter>
						<Border Grid.Column="2" Padding="7,0,4,0" VerticalAlignment="Center">
							<DockPanel>
								<StackPanel Name="m_inner_properties_container" Orientation="Horizontal" DockPanel.Dock="Right"/>
								<ContentControl Name="m_value_editor" Focusable="False" Content="{TemplateBinding value_editor}" >
									<ContentControl.Style>
										<Style>
											<Style.Triggers>
												<DataTrigger Binding="{Binding is_default_value}" Value="false">
													<Setter Property="Control.FontWeight" Value="Bold" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</ContentControl.Style>
								</ContentControl>
							</DockPanel>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
