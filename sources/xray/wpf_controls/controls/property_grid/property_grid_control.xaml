<ContentControl x:Class="xray.editor.wpf_controls.property_grid.property_grid_control"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:panels="clr-namespace:xray.editor.wpf_controls.panels"
                xmlns:sdk="clr-namespace:xray.editor.wpf_controls"
                MinHeight="23" MinWidth="50" UseLayoutRounding="True"
                FontFamily="{x:Static sdk:SdkWorkspaceTheme.FontFamily}" FontSize="{x:Static sdk:SdkWorkspaceTheme.FontSize}"
                Foreground="{x:Static sdk:SdkWorkspaceTheme.Text}"
                SizeChanged="property_grid_size_changed"
                GotFocus="this_ctrl_got_focus" LostFocus="this_ctrl_lost_focus">
    <ContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../themes/sdk_disclosure.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </ContentControl.Resources>
    <Border Background="{x:Static sdk:SdkWorkspaceTheme.Surface}" MouseDown="mouse_down">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{x:Static sdk:SdkWorkspaceTheme.Canvas}" BorderBrush="{x:Static sdk:SdkWorkspaceTheme.Divider}"
                    BorderThickness="0,0,0,1" Visibility="{Binding HasItems, ElementName=m_properties_panel, Converter={StaticResource VisibleWhenTrue}}">
                <Grid Height="29" Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Property" Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{x:Static sdk:SdkWorkspaceTheme.MutedText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="Value" Margin="7,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{x:Static sdk:SdkWorkspaceTheme.MutedText}"/>
                </Grid>
            </Border>
            <panels:scroll_viewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                <ItemsControl Name="m_properties_panel" BorderThickness="0" AutomationProperties.Name="Properties">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <Border Background="{x:Static sdk:SdkWorkspaceTheme.Chrome}"
                                                            BorderBrush="{x:Static sdk:SdkWorkspaceTheme.Divider}" BorderThickness="0,0,0,1">
                                                        <ToggleButton x:Name="CategoryToggle" Style="{StaticResource SdkDisclosure}"
                                                                      IsChecked="True" MinHeight="29" FontWeight="SemiBold"
                                                                      Content="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                                                    </Border>
                                                    <ItemsPresenter Visibility="{Binding IsChecked, ElementName=CategoryToggle, Converter={StaticResource VisibleWhenTrue}}"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </panels:scroll_viewer>
            <TextBlock Grid.Row="1" Text="No properties to display." Foreground="{x:Static sdk:SdkWorkspaceTheme.MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=m_properties_panel}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</ContentControl>
