<hypergraph:node x:Class="xray.editor.wpf_controls.hypergraph.properties_node"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:hypergraph="clr-namespace:xray.editor.wpf_controls.hypergraph" 
			 xmlns:sdk="clr-namespace:xray.editor.wpf_controls"
			 x:Name="this">
	<hypergraph:node.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../../../themes/sdk_disclosure.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="bool_to_visibility_converter"/>
		</ResourceDictionary>
	</hypergraph:node.Resources>
    <DockPanel>
		<ContentControl Name="m_above_header_content" DockPanel.Dock="Top" HorizontalAlignment="Left"/>
		<Border CornerRadius="5" Name="m_node_border" Background="{x:Static sdk:SdkWorkspaceTheme.Chrome}" SnapsToDevicePixels="True">
			<DockPanel Name="m_content_panel">
				<DockPanel DockPanel.Dock="Top" Name="m_header_panel" MinHeight="29" Margin="5,0">
					<hypergraph:link_point x:Name="m_input_link_point" id="input" DockPanel.Dock="Left" Visibility="Collapsed" />
					<hypergraph:link_point x:Name="m_output_link_point" id="output" DockPanel.Dock="Right" Visibility="Collapsed" />
					<ToggleButton DockPanel.Dock="Left" Style="{StaticResource SdkDisclosure}" Padding="0"
								  Visibility="{Binding has_expanded, ElementName=this, Converter={StaticResource bool_to_visibility_converter}}"
								  IsChecked="{Binding is_expanded, ElementName=this}" AutomationProperties.Name="Node properties"/>
					<Border Name="m_header" CornerRadius="1" Background="Transparent"
						Tag="{Binding ElementName=this}"
						PreviewMouseLeftButtonDown="header_mouse_down"
						MouseMove="header_mouse_move"
						PreviewMouseLeftButtonUp="header_mouse_up">
						<TextBlock Text="{Binding name, ElementName=this}" MinWidth="48" Padding="5,0"
						           FontFamily="{x:Static sdk:SdkWorkspaceTheme.FontFamily}" FontSize="{x:Static sdk:SdkWorkspaceTheme.FontSize}"
						           FontWeight="SemiBold" Foreground="{x:Static sdk:SdkWorkspaceTheme.Text}"
						           VerticalAlignment="Center" HorizontalAlignment="Center" Tag="{Binding ElementName=this}"/>
					</Border>
				</DockPanel>
				<Border BorderThickness="0,1,0,0" BorderBrush="{x:Static sdk:SdkWorkspaceTheme.Divider}" CornerRadius="0,0,4,4"
				        Background="{x:Static sdk:SdkWorkspaceTheme.Surface}" Visibility="{Binding is_expanded, ElementName=this, Converter={StaticResource bool_to_visibility_converter}}">
					<hypergraph:properties_control x:Name="m_property_container" Grid.IsSharedSizeScope="True"/>
				</Border>
			</DockPanel>
		</Border>
	</DockPanel>
</hypergraph:node>
