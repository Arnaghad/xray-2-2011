<UserControl x:Class="xray.editor.wpf_controls.hypergraph.link_point"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:xray.editor.wpf_controls"
			 MouseDown="link_place_mouse_down"
			 MinWidth="14" MinHeight="12">
	<Ellipse Width="9" Height="9" Fill="{x:Static sdk:SdkWorkspaceTheme.Surface}" Stroke="{x:Static sdk:SdkWorkspaceTheme.Accent}"
             StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</UserControl>
