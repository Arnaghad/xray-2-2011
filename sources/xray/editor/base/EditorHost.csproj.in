<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>11.0.0</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <LangVersion>15.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>xray.editor.base</AssemblyName>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RollForward>LatestPatch</RollForward>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath>@CMAKE_CURRENT_SOURCE_DIR@/EditorHost.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime patch changes must invalidate an existing hosted-library config. -->
    <GenerateRuntimeConfigurationFilesInputs Include="$(MSBuildProjectFullPath)" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/Bridge.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/EditorWorld.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/EditorWorld.Sdk.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkSound.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Sound.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkParticle.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Particle.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkDialog.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Dialog.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkScripting.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Scripting.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkNavigation.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Navigation.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkProperties.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/Command.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/CommandEngine.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkNativeResources.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/WindowIde.Models.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkObjExporter.cs" />
    <Compile Include="@CMAKE_CURRENT_SOURCE_DIR@/SdkModelEditor.cs" />
