<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:item="clr-namespace:xray.editor.avalonia_controls.property_editors.item"
                    xmlns:property_grid="clr-namespace:xray.editor.avalonia_controls.property_grid"
                    xmlns:sdk="clr-namespace:xray.editor.avalonia_controls">
  <ControlTheme x:Key="{x:Type item:named_item_editor}" TargetType="item:named_item_editor">
    <Setter Property="Template">
      <ControlTemplate x:DataType="item:named_item_editor" x:CompileBindings="False">
        <Grid MinHeight="23">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Padding="4,0,6,0"
                  MaxWidth="{Binding Path=(property_grid:property_grid_control.NameColumnLimit), RelativeSource={RelativeSource Self}}">
            <DockPanel>
              <Control DockPanel.Dock="Left" Width="{TemplateBinding item_indent}" Focusable="False" />
              <TextBlock Text="{Binding name}"
                         ToolTip.Tip="{Binding name}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1"
                        Width="5"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Focusable="False"
                        Background="Transparent">
            <GridSplitter.Template>
              <ControlTemplate>
                <Grid Background="Transparent">
                  <Border Name="Divider"
                          Width="1"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource SdkDividerBrush}" />
                </Grid>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>

          <Border Grid.Column="2" Padding="7,0,4,0" VerticalAlignment="Center">
            <DockPanel>
              <StackPanel Name="m_inner_properties_container" Orientation="Horizontal" DockPanel.Dock="Right" />
              <ContentControl Name="m_value_editor" Focusable="False" Content="{TemplateBinding value_editor}" />
            </DockPanel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
