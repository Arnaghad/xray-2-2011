<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:item="clr-namespace:xray.editor.avalonia_controls.property_editors.item">
  <ControlTheme x:Key="{x:Type item:data_source_editor}" TargetType="item:data_source_editor">
    <Setter Property="Template">
      <ControlTemplate x:DataType="item:data_source_editor" x:CompileBindings="False">
        <StackPanel>
          <Border BorderBrush="{DynamicResource SdkDividerBrush}" BorderThickness="0,0,0,1">
            <Grid MinHeight="22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Padding="4,0,6,0" Background="{DynamicResource SdkSurfaceBrush}">
                <StackPanel Orientation="Horizontal" Name="item_text_panel">
                  <Control Width="{TemplateBinding item_indent}" Focusable="False" />
                  <TextBlock Text="{Binding name}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SdkDividerBrush}" />

              <Border Grid.Column="2" Padding="5,0,2,0">
                <ContentControl Content="{TemplateBinding data_source_compo_box}" />
              </Border>
            </Grid>
          </Border>

          <Border Name="body" BorderBrush="{DynamicResource SdkDividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
              <ContentControl Content="{TemplateBinding value_editor}" />
              <Grid MinHeight="22">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                  <Control DockPanel.Dock="Left" Width="{TemplateBinding item_indent}" Focusable="False" />
                  <TextBlock Text="Input: " VerticalAlignment="Center" />
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SdkDividerBrush}" />
                <ContentControl Grid.Column="2" Content="{TemplateBinding input_combo_box}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
