<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:item="clr-namespace:xray.editor.avalonia_controls.property_editors.item">
  <ControlTheme x:Key="{x:Type item:material_stage_effect_editor}" TargetType="item:material_stage_effect_editor">
    <Setter Property="Template">
      <ControlTemplate x:DataType="item:material_stage_effect_editor" x:CompileBindings="False">
        <Grid MinHeight="22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="PropertyName" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Padding="4,0,6,0" Background="{DynamicResource SdkSurfaceBrush}">
            <StackPanel Orientation="Horizontal" Name="item_text_panel">
              <Control Width="{TemplateBinding item_indent}" Focusable="False" />
              <TextBlock Text="{Binding name}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SdkDividerBrush}" />

          <DockPanel Grid.Column="2">
            <Button Width="14"
                    Height="14"
                    Name="delete_item"
                    ToolTip.Tip="Delete this item"
                    DockPanel.Dock="Right"
                    Padding="0"
                    IsVisible="{Binding is_collection_item}">
              <Path Stroke="{DynamicResource SdkTextBrush}" StrokeThickness="1" Data="M0 0 L5 0" />
            </Button>
            <Border Name="m_edit_button"
                    Padding="5,0,2,0"
                    IsVisible="{TemplateBinding is_can_edit_effect}"
                    DataContext="{x:Null}">
              <ContentControl Content="{TemplateBinding effects_editor}" />
            </Border>
          </DockPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
