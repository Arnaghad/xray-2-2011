<value:value_editor_base xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:xray.editor.avalonia_controls"
                         xmlns:value="clr-namespace:xray.editor.avalonia_controls.property_editors.value"
                         x:Class="xray.editor.avalonia_controls.property_editors.value.color_curve_editor">
  <DockPanel>
    <local:ruler x:Name="m_ruler" DockPanel.Dock="Top" Height="20" top_to_down="False" />
    <local:color_ramp x:Name="m_color_ramp" Height="30" />
  </DockPanel>
</value:value_editor_base>
