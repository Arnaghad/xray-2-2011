<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:value="clr-namespace:xray.editor.avalonia_controls.property_editors.value">
  <ControlTheme x:Key="{x:Type value:string_editor}" TargetType="value:string_editor">
    <Setter Property="Template">
      <ControlTemplate x:DataType="value:string_editor" x:CompileBindings="False">
        <TextBox Name="PART_text_box" Text="{Binding value}" BorderThickness="0" Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
