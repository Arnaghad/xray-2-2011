<editors:value_editor_base xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:editors="clr-namespace:xray.editor.avalonia_controls.property_editors.value"
                           x:Class="xray.editor.avalonia_controls.property_editors.value.string_select_file_editor">
  <DockPanel>
    <Button Name="Browse" Width="18" DockPanel.Dock="Right" Content="..." Padding="0,-2,0,-2" />
    <TextBox Name="file_path" Foreground="Gray" BorderThickness="0" />
  </DockPanel>
</editors:value_editor_base>
