<value:value_editor_base xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:matrix_editor="clr-namespace:xray.editor.avalonia_controls.color_matrix_editor"
                         xmlns:value="clr-namespace:xray.editor.avalonia_controls.property_editors.value"
                         x:Class="xray.editor.avalonia_controls.property_editors.value.color_matrix_editor">
  <DockPanel>
    <Button DockPanel.Dock="Right" Width="15" Name="big_editor">
      <Path Data="M0 0 L8 5 L0 10" Fill="{DynamicResource SdkTextBrush}" />
    </Button>
    <Border Padding="3" MinHeight="100">
      <matrix_editor:color_matrix_control x:Name="m_color_matrix_editor" />
    </Border>
  </DockPanel>
</value:value_editor_base>
