<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:xray.editor.avalonia_controls"
             xmlns:animation_playback="using:xray.editor.avalonia_controls.animation_playback"
             x:Class="xray.editor.avalonia_controls.animation_playback.animation_playback_panel"
             x:CompileBindings="False">
    <UserControl.Resources>
        <DataTemplate x:Key="animation_item" x:DataType="animation_playback:animation_item">
            <animation_playback:animation_item_view />
        </DataTemplate>
        <DataTemplate x:Key="animation_item_name" x:DataType="animation_playback:animation_item">
            <animation_playback:animation_item_name_view />
        </DataTemplate>
    </UserControl.Resources>
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,*,Auto">
        <Border Grid.RowSpan="2" BorderThickness="1" BorderBrush="Black">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="40">
                    <DockPanel>
                        <TextBlock Text="Frames" HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Top" Height="25" />
                        <TextBlock Text="Milliseconds" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="15" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Height="20">
                    <TextBlock Text="Current time" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" x:Name="m_names_scroller" ScrollChanged="scroll_viewer_scroll_changed">
                    <ItemsControl x:Name="m_animation_item_names" ItemTemplate="{StaticResource animation_item_name}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="2" Grid.Column="1" BorderThickness="1" BorderBrush="Black">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" x:Name="m_animations_h_scroller">
                <Grid x:Name="own_grid" Width="{Binding max_time_scaled}" MinWidth="10">
                    <DockPanel>
                        <Border Height="40" Background="Gray" DockPanel.Dock="Top" x:Name="m_timeline_up" PointerPressed="timeline_mouse_down">
                            <DockPanel>
                                <local:ruler x:Name="time_layout_ruler_f" DockPanel.Dock="Top" Height="20" />
                                <local:ruler x:Name="time_layout_ruler_s" Height="20" />
                            </DockPanel>
                        </Border>
                        <Border Height="20" DockPanel.Dock="Bottom" />
                        <ScrollViewer x:Name="m_animations_scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ScrollChanged="scroll_viewer_scroll_changed">
                            <ItemsControl x:Name="m_animation_item_views" ItemTemplate="{StaticResource animation_item}" />
                        </ScrollViewer>
                    </DockPanel>
                    <Canvas>
                        <Thumb x:Name="m_time_thumb"
                               Canvas.Left="{Binding animation_thumb_position}"
                               Width="200"
                               Height="{Binding $parent[Grid].Bounds.Height}"
                               Background="Red"
                               DragDelta="thumb_drag_delta">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Grid ColumnDefinitions="*,*">
                                        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="1" BorderBrush="Red" BorderThickness="1" />
                                        <Path Grid.ColumnSpan="2" HorizontalAlignment="Center" Data="M 0,10 L 12,10 L 12,30 L 0,30 Z" Stroke="Black" Fill="Red" />
                                        <TextBlock Margin="0,0,5,2" Grid.Column="0" Text="{Binding current_time_text_frames}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                        <TextBlock Margin="5,0,0,2" Grid.Column="1" Text="{Binding current_time_text_seconds}" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>

        <ScrollBar Grid.Column="2" Grid.RowSpan="2" LargeChange="1000" SmallChange="100" x:Name="m_vertical_scrollbar" ValueChanged="m_vertical_scrollbar_scroll" />
        <ScrollBar Grid.Column="1" Grid.Row="2" LargeChange="1000" SmallChange="100" Orientation="Horizontal" x:Name="m_horizontal_scrollbar" ValueChanged="m_horizontal_scrollbar_scroll" />
    </Grid>
</UserControl>
