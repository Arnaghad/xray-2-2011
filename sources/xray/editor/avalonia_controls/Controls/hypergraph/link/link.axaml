<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="xray.editor.avalonia_controls.hypergraph.link"
             ClipToBounds="False"
             ZIndex="2000000000">
    <Canvas ClipToBounds="False">
        <Path x:Name="m_line"
              Fill="Transparent"
              StrokeThickness="3"
              StrokeLineCap="Round" />
        <Path x:Name="m_arrow_shape"
              Stroke="Transparent"
              StrokeThickness="1"
              StrokeJoin="Miter"
              StrokeLineCap="Square" />
        <ContentControl x:Name="m_link_content" SizeChanged="link_content_size_changed" />
    </Canvas>
</UserControl>
