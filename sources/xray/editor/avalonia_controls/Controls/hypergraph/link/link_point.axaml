<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             x:Class="xray.editor.avalonia_controls.hypergraph.link_point"
             Background="Transparent"
             MinWidth="14"
             MinHeight="12"
             PointerPressed="link_place_mouse_down">
    <Ellipse x:Name="m_dot"
             Width="9"
             Height="9"
             Fill="{x:Static themes:SdkWorkspaceTheme.Surface}"
             Stroke="{x:Static themes:SdkWorkspaceTheme.Accent}"
             StrokeThickness="2"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
</UserControl>
