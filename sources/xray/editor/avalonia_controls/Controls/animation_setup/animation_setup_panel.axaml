<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:xray.editor.avalonia_controls"
             xmlns:animation_setup="using:xray.editor.avalonia_controls.animation_setup"
             x:Class="xray.editor.avalonia_controls.animation_setup.animation_setup_panel"
             x:CompileBindings="False"
             Loaded="user_control_loaded">
    <UserControl.Resources>
        <DataTemplate x:Key="animation_channel">
            <animation_setup:animation_channel_list_view />
        </DataTemplate>
        <DataTemplate x:Key="animation_channel_name">
            <animation_setup:animation_channel_name_view />
        </DataTemplate>
        <ContextMenu x:Key="panel_context_menu">
            <MenuItem Header="Add partitions channel:">
                <MenuItem Header="anim_intervals" Click="add_new_channel_click" />
                <MenuItem Header="foot_steps" Click="add_new_channel_click" />
            </MenuItem>
            <MenuItem Header="Add intervals channel:">
                <MenuItem Header="intervals" Click="add_new_channel_click" />
            </MenuItem>
            <MenuItem Header="Add events channel:">
                <MenuItem Header="sound_events" Click="add_new_channel_click" />
            </MenuItem>
            <MenuItem Header="Paste channel" Click="paste_channel_click" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" BorderThickness="1" BorderBrush="Black">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="40" BorderBrush="Black" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="Milliseconds" HorizontalAlignment="Center" VerticalAlignment="Top" DockPanel.Dock="Top" Height="25" />
                        <TextBlock Text="Frames" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="15" />
                    </DockPanel>
                </Border>
                <Border Height="15" DockPanel.Dock="Top" BorderBrush="Black" BorderThickness="1">
                    <TextBlock Text="Channels:" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border DockPanel.Dock="Bottom" Height="20">
                    <TextBlock Text="Current time" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              x:Name="m_names_scroller"
                              ScrollChanged="scroll_viewer_scroll_changed"
                              PointerPressed="channels_scroller_mouse_right_button_down">
                    <ItemsControl x:Name="m_animation_channel_names" ItemTemplate="{StaticResource animation_channel_name}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.RowSpan="2" Grid.Column="1" BorderThickness="1" BorderBrush="Black">
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Hidden"
                          x:Name="m_channels_h_scroller"
                          ScrollChanged="channels_h_scroller_scroll_changed">
                <Grid x:Name="own_grid"
                      Width="{Binding max_time_scaled}"
                      PointerMoved="own_grid_mouse_move"
                      PointerReleased="own_grid_mouse_left_button_up">
                    <DockPanel>
                        <Border Height="40" Background="Gray" DockPanel.Dock="Top" x:Name="m_timeline_up">
                            <DockPanel>
                                <local:ruler x:Name="time_layout_ruler_s" DockPanel.Dock="Top" Height="20" />
                                <local:ruler x:Name="time_layout_ruler_f" Height="20" />
                            </DockPanel>
                        </Border>
                        <Border Height="15" DockPanel.Dock="Top" BorderThickness="1" BorderBrush="Black">
                            <Separator />
                        </Border>
                        <Border Height="20" DockPanel.Dock="Bottom" />
                        <ScrollViewer x:Name="m_channels_scroller"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      ScrollChanged="scroll_viewer_scroll_changed"
                                      PointerPressed="channels_scroller_mouse_right_button_down">
                            <ItemsControl x:Name="m_animation_channel_views" ItemTemplate="{StaticResource animation_channel}" />
                        </ScrollViewer>
                    </DockPanel>
                    <Canvas>
                        <Thumb x:Name="m_time_thumb"
                               Canvas.Left="{Binding animation_thumb_position}"
                               Width="200"
                               Height="{Binding Bounds.Height, ElementName=own_grid}"
                               Background="Red"
                               DragDelta="thumb_drag_delta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="1" BorderBrush="Red" BorderThickness="1" />
                                        <Path Grid.ColumnSpan="2" HorizontalAlignment="Center" Data="M0 10 L12 10 L12 30 L 0 30 Z" Stroke="Black" Fill="Red" />
                                        <TextBlock Margin="0,0,5,2" Grid.Column="0" Text="{Binding current_time_text_frames}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                        <TextBlock Margin="5,0,0,2" Grid.Column="1" Text="{Binding current_time_text_seconds}" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>
        <ScrollBar Grid.Column="2"
                   Grid.RowSpan="2"
                   Orientation="Vertical"
                   LargeChange="1000"
                   SmallChange="100"
                   x:Name="m_vertical_scrollbar"
                   ValueChanged="m_vertical_scrollbar_value_changed" />
        <ScrollBar Grid.Column="1"
                   Grid.Row="2"
                   LargeChange="1000"
                   SmallChange="100"
                   Orientation="Horizontal"
                   x:Name="m_horizontal_scrollbar"
                   ValueChanged="m_horizontal_scrollbar_value_changed" />
    </Grid>
</UserControl>
