<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="xray.editor.avalonia_controls.animation_setup.animation_channel_list_view"
             x:CompileBindings="False">
    <Border Height="40" Background="DarkGray" BorderThickness="1" BorderBrush="Black">
        <ItemsControl x:Name="m_channel_views">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</UserControl>
