<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:themes="using:xray.editor.avalonia_controls.Themes"
        x:Class="xray.editor.avalonia_controls.Shell.SdkAvaloniaShellWindow"
        Title="X-Ray 2.0 SDK"
        Width="1280"
        Height="760"
        Background="{x:Static themes:SdkWorkspaceTheme.Canvas}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{x:Static themes:SdkWorkspaceTheme.Canvas}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="8,2">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Padding="7,2"
                        CornerRadius="4"
                        Background="#1D232E"
                        BorderBrush="#2E3848"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Width="6" Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{x:Static themes:SdkWorkspaceTheme.Accent}" />
                        <TextBlock Text="X-RAY 2.0"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Static themes:SdkWorkspaceTheme.Text}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Menu x:Name="m_main_menu" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#1E232C"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel x:Name="m_main_toolbar"
                        Orientation="Horizontal"
                        Spacing="3" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{x:Static themes:SdkWorkspaceTheme.Canvas}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border Width="7" Height="7"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{x:Static themes:SdkWorkspaceTheme.Success}" />
                    <TextBlock x:Name="m_status_label"
                               VerticalAlignment="Center"
                               Foreground="{x:Static themes:SdkWorkspaceTheme.Text}"
                               FontSize="11.5"
                               Text="Ready" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        CornerRadius="4"
                        Background="#1B2029"
                        BorderBrush="#2A3240"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="m_camera_label"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}"
                               Text="Camera: 0.0, 0.0, 0.0" />
                </Border>
                <Border Grid.Column="2"
                        Margin="6,0,8,0"
                        Padding="8,2"
                        CornerRadius="4"
                        Background="#1B2029"
                        BorderBrush="#2A3240"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="m_grid_label"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}"
                               Text="Grid: 100 x 100" />
                </Border>
                <Button x:Name="m_error_button"
                        Grid.Column="3"
                        Padding="9,2"
                        CornerRadius="4"
                        FontSize="11"
                        Content="Errors: 0" />
            </Grid>
        </Border>

        <dock:DockControl x:Name="m_dock_control" Margin="2,2,2,0" />
    </DockPanel>
</Window>
