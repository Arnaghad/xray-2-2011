<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:xray.editor.avalonia_controls.Editors"
        xmlns:themes="using:xray.editor.avalonia_controls.Themes"
        x:Class="xray.editor.avalonia_controls.Editors.SdkRenderOptionsEditorWindow"
        Title="Render options"
        Width="1000"
        Height="620"
        Background="{x:Static themes:SdkWorkspaceTheme.Surface}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="m_apply_button" Margin="0,0,4,0" Content="Apply mapped options" />
                <Button x:Name="m_save_button" Margin="0,0,4,0" Content="Save source" />
                <Button x:Name="m_undo_button" Margin="0,0,4,0" Content="Undo" />
                <Button x:Name="m_redo_button" Margin="0,0,4,0" Content="Redo" />
                <Button x:Name="m_revert_button" Content="Revert draft" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock x:Name="m_status_label"
                       TextWrapping="Wrap"
                       Foreground="{x:Static themes:SdkWorkspaceTheme.Text}" />
        </Border>

        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                    BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <Grid ColumnDefinitions="2*,1*,1.2*,1*,2.5*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Original option" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Mapped value" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Preserved source" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Capability" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Renderer mapping" />
                </Grid>
            </Border>

            <ListBox x:Name="m_options_list">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SdkRenderOptionRow">
                        <Grid ColumnDefinitions="2*,1*,1.2*,1*,2.5*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Key}" />
                            <CheckBox Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding MappedValue, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEditable}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding PreservedSource}" Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Capability}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Explanation}" Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
