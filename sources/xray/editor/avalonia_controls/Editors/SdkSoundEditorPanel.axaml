<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:curve_editor="using:xray.editor.avalonia_controls.curve_editor"
             xmlns:pg="using:xray.editor.avalonia_controls.property_grid"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             xmlns:local="using:xray.editor.avalonia_controls.Editors"
             x:Class="xray.editor.avalonia_controls.Editors.SdkSoundEditorPanel"
             Background="{x:Static themes:SdkWorkspaceTheme.Surface}">
  <DockPanel LastChildFill="True">
    <!-- Top toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
            BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
            BorderThickness="0,0,0,1"
            Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="m_play_button" Content="Play" Padding="10,4" />
        <Button x:Name="m_loop_button" Content="Loop" Padding="10,4" />
        <Button x:Name="m_pause_button" Content="Pause" Padding="10,4" />
        <Button x:Name="m_stop_button" Content="Stop" Padding="10,4" />
        <Border Width="1" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" Margin="4,2" />
        <Button x:Name="m_undo_button" Content="Undo" Padding="10,4" />
        <Button x:Name="m_redo_button" Content="Redo" Padding="10,4" />
        <Border Width="1" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" Margin="4,2" />
        <Button x:Name="m_reload_button" Content="Reload" Padding="10,4" />
        <Button x:Name="m_save_button" Content="Save" Padding="10,4" />
      </StackPanel>
    </Border>

    <!-- Bottom status strip -->
    <Border DockPanel.Dock="Bottom"
            Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
            BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
            BorderThickness="0,1,0,0"
            Padding="8,4">
      <TextBlock x:Name="m_status_label"
                 Text="Audio backend ready"
                 Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}"
                 FontSize="12" />
    </Border>

    <!-- Tabs + Inspector -->
    <Grid RowDefinitions="*,Auto,220">
      <TabControl x:Name="m_tabs" Grid.Row="0" Margin="4">
        <TabItem Header="Single Sound (SPL)">
          <Grid RowDefinitions="110,Auto,*">
            <local:SdkSoundWaveformView x:Name="m_waveform_view" Grid.Row="0" Margin="0,0,0,4" />
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" />
            <curve_editor:curve_editor_panel x:Name="m_curve_panel"
                                             Grid.Row="2"
                                             is_toolbar_visible="True"
                                             is_hierarchy_visible="True" />
          </Grid>
        </TabItem>
        <TabItem Header="Collection">
          <ListBox x:Name="m_collection_list"
                   Background="{x:Static themes:SdkWorkspaceTheme.Surface}"
                   BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                   BorderThickness="1" />
        </TabItem>
        <TabItem Header="Composite">
          <ListBox x:Name="m_composite_list"
                   Background="{x:Static themes:SdkWorkspaceTheme.Surface}"
                   BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                   BorderThickness="1" />
        </TabItem>
        <TabItem Header="Sound Scene">
          <ListBox x:Name="m_scene_list"
                   Background="{x:Static themes:SdkWorkspaceTheme.Surface}"
                   BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                   BorderThickness="1" />
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" />

      <Border Grid.Row="2"
              BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
              BorderThickness="0,1,0,0"
              Padding="4">
        <pg:property_grid_control x:Name="m_grid" />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
