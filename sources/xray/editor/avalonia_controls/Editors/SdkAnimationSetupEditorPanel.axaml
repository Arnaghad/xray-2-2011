<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="using:xray.editor.avalonia_controls.animation_setup"
             xmlns:pg="using:xray.editor.avalonia_controls.property_grid"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             x:Class="xray.editor.avalonia_controls.Editors.SdkAnimationSetupEditorPanel"
             Background="{x:Static themes:SdkWorkspaceTheme.Surface}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="m_save_button" Margin="0,0,4,0" Content="Save" />
                <Button x:Name="m_undo_button" Margin="0,0,4,0" Content="Undo" />
                <Button x:Name="m_redo_button" Margin="0,0,4,0" Content="Redo" />
                <Button x:Name="m_add_partitions_button" Margin="0,0,4,0" Content="Add partitions" />
                <Button x:Name="m_add_events_button" Content="Add events" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock x:Name="m_status_label"
                       Foreground="{x:Static themes:SdkWorkspaceTheme.Text}" />
        </Border>

        <Grid ColumnDefinitions="320,4,*">
            <Grid Grid.Column="0" RowDefinitions="200,4,*">
                <ListBox x:Name="m_channels_list" Grid.Row="0" />
                <GridSplitter Grid.Row="1" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" />
                <pg:property_grid_control x:Name="m_grid" Grid.Row="2" />
            </Grid>

            <GridSplitter Grid.Column="1" Background="{x:Static themes:SdkWorkspaceTheme.Divider}" />

            <setup:animation_setup_panel x:Name="m_setup_panel" Grid.Column="2" IsChannelEditingEnabled="False" />
        </Grid>
    </DockPanel>
</UserControl>
