<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:xray.editor.avalonia_controls.Ide.Controls"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             x:Class="xray.editor.avalonia_controls.Ide.Panels.SdkProjectPanel"
             Background="{x:Static themes:SdkWorkspaceTheme.Surface}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,1,0,0"
                Padding="6,3">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="m_total_label"
                           Foreground="{x:Static themes:SdkWorkspaceTheme.Text}"
                           Text="Total:0" />
                <TextBlock x:Name="m_selected_label"
                           Foreground="{x:Static themes:SdkWorkspaceTheme.MutedText}"
                           Text="Selected:0" />
            </StackPanel>
        </Border>

        <Grid x:Name="m_rename_panel" DockPanel.Dock="Bottom" IsVisible="False"
              ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="6,4">
            <TextBlock Text="Rename" VerticalAlignment="Center" />
            <TextBox x:Name="m_rename_box" Grid.Column="1" AutomationProperties.Name="Project item name" />
        </Grid>

        <ctrl:SdkTreeView x:Name="m_tree_view">
            <ctrl:SdkTreeView.ContextMenu>
                <ContextMenu x:Name="m_context_menu">
                    <MenuItem x:Name="m_add_menu" Header="Add">
                        <MenuItem x:Name="m_new_filter_menu" Header="New Filter" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="m_remove_menu" Header="Remove" />
                    <MenuItem x:Name="m_add_ignore_menu" Header="Add to ignore list" />
                    <MenuItem x:Name="m_remove_ignore_menu" Header="Remove from ignore list" />
                </ContextMenu>
            </ctrl:SdkTreeView.ContextMenu>
        </ctrl:SdkTreeView>
    </DockPanel>
</UserControl>
