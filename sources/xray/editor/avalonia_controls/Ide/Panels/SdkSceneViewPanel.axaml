<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             x:Class="xray.editor.avalonia_controls.Ide.Panels.SdkSceneViewPanel"
             Background="{x:Static themes:SdkWorkspaceTheme.Canvas}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="#1D222B"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <WrapPanel x:Name="m_toolbar_panel"
                       Orientation="Horizontal" />
        </Border>
        <ContentControl x:Name="m_viewport_container" />
    </DockPanel>
</UserControl>
