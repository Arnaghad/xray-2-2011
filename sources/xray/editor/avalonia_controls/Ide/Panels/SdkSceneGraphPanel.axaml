<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hg="using:xray.editor.avalonia_controls.hypergraph"
             xmlns:themes="using:xray.editor.avalonia_controls.Themes"
             x:Class="xray.editor.avalonia_controls.Ide.Panels.SdkSceneGraphPanel"
             Background="{x:Static themes:SdkWorkspaceTheme.Canvas}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{x:Static themes:SdkWorkspaceTheme.Chrome}"
                BorderBrush="{x:Static themes:SdkWorkspaceTheme.Divider}"
                BorderThickness="0,0,0,1"
                Padding="5,4">
            <Button x:Name="m_initialize_button"
                    Padding="10,3"
                    Content="Initialize" />
        </Border>
        <hg:hypergraph_control x:Name="m_hypergraph" />
    </DockPanel>
</UserControl>
