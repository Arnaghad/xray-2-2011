<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="xray.editor.avalonia_controls.color_matrix_editor.control_point"
             Height="6"
             Width="6"
             Background="Gray"
             BorderBrush="Black"
             BorderThickness="1">
  <UserControl.ContextMenu>
    <ContextMenu x:Name="m_point_context_menu">
      <MenuItem x:Name="m_remove_horizontal" Header="Remove Horizontal" />
      <MenuItem x:Name="m_remove_vertical" Header="Remove Vertical" />
    </ContextMenu>
  </UserControl.ContextMenu>
</UserControl>
