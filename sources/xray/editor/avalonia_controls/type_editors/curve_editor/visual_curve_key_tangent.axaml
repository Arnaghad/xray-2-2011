<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="xray.editor.avalonia_controls.curve_editor.visual_curve_key_tangent"
             Width="8"
             Height="8"
             Background="Transparent"
             Cursor="Hand">
    <Rectangle x:Name="m_rect"
               Width="7"
               Height="7"
               Fill="#FFFFFF"
               Stroke="#233447"
               StrokeThickness="1" />
</UserControl>
