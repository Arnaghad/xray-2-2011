<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="xray.editor.avalonia_controls.curve_editor.visual_curve_key_range_control"
             Width="10"
             Height="10"
             Background="Transparent"
             Cursor="SizeNorthSouth">
    <Polygon x:Name="m_shape"
             Points="5,0 10,5 5,10 0,5"
             Fill="#FFFFFF"
             Stroke="#176B80"
             StrokeThickness="1.2" />
</UserControl>
