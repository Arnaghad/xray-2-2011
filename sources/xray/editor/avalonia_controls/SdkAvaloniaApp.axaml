<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockThemes="using:Dock.Avalonia.Themes.Fluent"
             x:Class="xray.editor.avalonia_controls.SdkAvaloniaApp"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <dockThemes:DockFluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://xray.editor.avalonia_controls/Themes/SdkWorkspaceTheme.axaml" />
        <ResourceInclude Source="avares://xray.editor.avalonia_controls/Themes/generic.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
