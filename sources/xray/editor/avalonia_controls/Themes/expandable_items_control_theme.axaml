<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:xray.editor.avalonia_controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://xray.editor.avalonia_controls/Themes/sdk_disclosure.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="{x:Type local:expandable_items_control}" TargetType="local:expandable_items_control">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Background="{TemplateBinding Background}">
          <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SdkGridLineBrush}">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding left_pocket}" />
              <ToggleButton Theme="{StaticResource SdkDisclosure}"
                            Width="24"
                            Padding="0"
                            IsChecked="{TemplateBinding is_expanded, Mode=TwoWay}"
                            DockPanel.Dock="Left"
                            IsVisible="{TemplateBinding is_expand_visible}"
                            AutomationProperties.Name="{TemplateBinding name}" />
              <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding right_pocket}" />
              <ContentPresenter Content="{TemplateBinding Header}" />
            </DockPanel>
          </Border>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          Margin="{x:Static local:settings.hierarchical_item_indent_thickness}"
                          IsVisible="{TemplateBinding is_expanded}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
