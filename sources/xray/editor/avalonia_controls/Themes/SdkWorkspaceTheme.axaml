<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="SdkFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <x:Double x:Key="SdkFontSize">12</x:Double>

  <!-- DockFluentTheme studio geometry metrics -->
  <x:Double x:Key="DockCornerRadiusSmall">4</x:Double>
  <x:Double x:Key="DockHeaderHeight">26</x:Double>
  <x:Double x:Key="DockTabHeight">28</x:Double>
  <CornerRadius x:Key="DockDocumentTabItemCornerRadius">4,4,0,0</CornerRadius>
  <Thickness x:Key="DockDocumentTabItemPadding">10,0,8,0</Thickness>

  <!-- DockFluentTheme dark graphite brush overrides -->
  <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#14171C" />
  <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#1B1F26" />
  <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#1B1F26" />
  <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#1B1F26" />
  <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#20252E" />
  <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#262E3B" />
  <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#1B1F26" />
  <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#21262F" />
  <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#2D3542" />
  <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#2D8CFF" />
  <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#E6ECF5" />
  <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#2A313E" />
  <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#364052" />
  <SolidColorBrush x:Key="DockSeparatorBrush" Color="#2A313E" />
  <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#14171C" />
  <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#2D8CFF" />
  <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#4AA0FF" />
  <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#161A20" />
  <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="#1B2028" />
  <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#262E3A" />
  <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#222934" />
  <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#2D8CFF" />
  <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#93A1B5" />
  <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#E6ECF5" />
  <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#F2F7FF" />
  <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#B8C5D6" />
  <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#1F3B5C" />
  <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#2D8CFF" />
  <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#4AA0FF" />
  <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#2D8CFF" />
  <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#303A4A" />
  <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#1D232C" />
  <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#C93B3B" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="SdkSurfaceColor">#1B1F26</Color>
      <Color x:Key="SdkCanvasColor">#14171C</Color>
      <Color x:Key="SdkChromeColor">#21262F</Color>
      <Color x:Key="SdkInputColor">#151920</Color>
      <Color x:Key="SdkElevatedColor">#282F3B</Color>
      <Color x:Key="SdkDividerColor">#303846</Color>
      <Color x:Key="SdkGridLineColor">#252C37</Color>
      <Color x:Key="SdkAxisColor">#64748B</Color>
      <Color x:Key="SdkTextColor">#E6ECF5</Color>
      <Color x:Key="SdkMutedTextColor">#93A1B5</Color>
      <Color x:Key="SdkAccentColor">#2D8CFF</Color>
      <Color x:Key="SdkHoverColor">#2A3240</Color>
      <Color x:Key="SdkSelectionColor">#1F3B5C</Color>
      <Color x:Key="SdkSelectionTextColor">#F2F7FF</Color>
      <Color x:Key="SdkWarningColor">#E55353</Color>
      <Color x:Key="SdkSuccessColor">#34C77B</Color>

      <SolidColorBrush x:Key="SdkSurfaceBrush" Color="{StaticResource SdkSurfaceColor}" />
      <SolidColorBrush x:Key="SdkCanvasBrush" Color="{StaticResource SdkCanvasColor}" />
      <SolidColorBrush x:Key="SdkChromeBrush" Color="{StaticResource SdkChromeColor}" />
      <SolidColorBrush x:Key="SdkInputBrush" Color="{StaticResource SdkInputColor}" />
      <SolidColorBrush x:Key="SdkElevatedBrush" Color="{StaticResource SdkElevatedColor}" />
      <SolidColorBrush x:Key="SdkDividerBrush" Color="{StaticResource SdkDividerColor}" />
      <SolidColorBrush x:Key="SdkGridLineBrush" Color="{StaticResource SdkGridLineColor}" />
      <SolidColorBrush x:Key="SdkAxisBrush" Color="{StaticResource SdkAxisColor}" />
      <SolidColorBrush x:Key="SdkTextBrush" Color="{StaticResource SdkTextColor}" />
      <SolidColorBrush x:Key="SdkMutedTextBrush" Color="{StaticResource SdkMutedTextColor}" />
      <SolidColorBrush x:Key="SdkAccentBrush" Color="{StaticResource SdkAccentColor}" />
      <SolidColorBrush x:Key="SdkHoverBrush" Color="{StaticResource SdkHoverColor}" />
      <SolidColorBrush x:Key="SdkSelectionBrush" Color="{StaticResource SdkSelectionColor}" />
      <SolidColorBrush x:Key="SdkSelectionTextBrush" Color="{StaticResource SdkSelectionTextColor}" />
      <SolidColorBrush x:Key="SdkWarningBrush" Color="{StaticResource SdkWarningColor}" />
      <SolidColorBrush x:Key="SdkSuccessBrush" Color="{StaticResource SdkSuccessColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SdkSurfaceColor">#1B1F26</Color>
      <Color x:Key="SdkCanvasColor">#14171C</Color>
      <Color x:Key="SdkChromeColor">#21262F</Color>
      <Color x:Key="SdkInputColor">#151920</Color>
      <Color x:Key="SdkElevatedColor">#282F3B</Color>
      <Color x:Key="SdkDividerColor">#303846</Color>
      <Color x:Key="SdkGridLineColor">#252C37</Color>
      <Color x:Key="SdkAxisColor">#64748B</Color>
      <Color x:Key="SdkTextColor">#E6ECF5</Color>
      <Color x:Key="SdkMutedTextColor">#93A1B5</Color>
      <Color x:Key="SdkAccentColor">#2D8CFF</Color>
      <Color x:Key="SdkHoverColor">#2A3240</Color>
      <Color x:Key="SdkSelectionColor">#1F3B5C</Color>
      <Color x:Key="SdkSelectionTextColor">#F2F7FF</Color>
      <Color x:Key="SdkWarningColor">#E55353</Color>
      <Color x:Key="SdkSuccessColor">#34C77B</Color>

      <SolidColorBrush x:Key="SdkSurfaceBrush" Color="{StaticResource SdkSurfaceColor}" />
      <SolidColorBrush x:Key="SdkCanvasBrush" Color="{StaticResource SdkCanvasColor}" />
      <SolidColorBrush x:Key="SdkChromeBrush" Color="{StaticResource SdkChromeColor}" />
      <SolidColorBrush x:Key="SdkInputBrush" Color="{StaticResource SdkInputColor}" />
      <SolidColorBrush x:Key="SdkElevatedBrush" Color="{StaticResource SdkElevatedColor}" />
      <SolidColorBrush x:Key="SdkDividerBrush" Color="{StaticResource SdkDividerColor}" />
      <SolidColorBrush x:Key="SdkGridLineBrush" Color="{StaticResource SdkGridLineColor}" />
      <SolidColorBrush x:Key="SdkAxisBrush" Color="{StaticResource SdkAxisColor}" />
      <SolidColorBrush x:Key="SdkTextBrush" Color="{StaticResource SdkTextColor}" />
      <SolidColorBrush x:Key="SdkMutedTextBrush" Color="{StaticResource SdkMutedTextColor}" />
      <SolidColorBrush x:Key="SdkAccentBrush" Color="{StaticResource SdkAccentColor}" />
      <SolidColorBrush x:Key="SdkHoverBrush" Color="{StaticResource SdkHoverColor}" />
      <SolidColorBrush x:Key="SdkSelectionBrush" Color="{StaticResource SdkSelectionColor}" />
      <SolidColorBrush x:Key="SdkSelectionTextBrush" Color="{StaticResource SdkSelectionTextColor}" />
      <SolidColorBrush x:Key="SdkWarningBrush" Color="{StaticResource SdkWarningColor}" />
      <SolidColorBrush x:Key="SdkSuccessBrush" Color="{StaticResource SdkSuccessColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
